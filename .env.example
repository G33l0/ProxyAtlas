# ProxyAtlas environment configuration (optional)
# Copy to .env and fill in. NEVER commit .env with real secrets.

# Override the data directory (default: platform user data dir)
# PROXYATLAS_DATA_DIR=/path/to/data

# Master key for credential encryption. If unset, a per-install key is
# generated and stored in the data directory with restricted permissions.
# PROXYATLAS_SECRET_KEY=

# Optional API keys for intelligence / discovery providers.
# These can also be set in-app under Settings > Providers.
# IPINFO_TOKEN=
# PROXY_FEED_API_KEY=
